{
  "Logging": {
    "LogLevel": {
      "Default": "Information"
    }
  },
  "Eds": {
    "BaseUrl": "https://main--site-prod--bangkok-bank.aem.live",
    "IndexPaths": [
      "/en/query-index.json",
      "/th/query-index.json"
    ],
    "Redis": "localhost:6379",
    "Dim": 2048,
    "Concurrency": 8,
    "Proxy": "",
    "ApiKey": "",
    "Weights": {
      "Title": 0.6,
      "Keywords": 1,
      "Description": 0.8,
      "Content": 0.5
    },
    "Embedding": {
      "Provider": "onnx",
      "ModelPath": "models/model.onnx",
      "TokenizerPath": "models/sentencepiece.bpe.model",
      "MaxTokens": 256,
      "MaxChunks": 3,
      "BatchSize": 16,
      "QueryPrefix": "query: ",
      "PassagePrefix": "passage: ",
      "Threads": 0
    },
    "Summary": {
      "TopDocs": 5,
      "PerDoc": 40,
      "MaxSentences": 4
    },
    "Llm": {
      "Enabled": true,
      "ModelPath": "models/phi35/cpu_and_mobile/cpu-int4-awq-block-128-acc-level-4",
      "Template": "phi3",
      "Evidence": 8,
      "MaxNewTokens": 300
    }
  }
}