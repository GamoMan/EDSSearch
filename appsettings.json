{
  "Logging": {
    "LogLevel": {
      "Default": "Information"
    }
  },
  "Eds": {
    "BaseUrl": "https://main--site-prod--bangkok-bank.aem.live",
    "ApiKey": "",
    "Proxy": {
      "Enabled": true,
      "Address": "",
      "Mode": "include",
      "Hosts": [],
      "UseDefaultCredentials": true,
      "User": "",
      "Password": ""
    },
    "IndexPaths": [
      "/en/query-index.json",
      "/th/query-index.json"
    ],
    "Store": "azure",
    "Redis": "localhost:6379",
    "Azure": {
      "Endpoint": "https://bbl-aem-ai-search.search.windows.net",
      "ApiKey": "HMV80wobPYffpVSrYIKgaT7gleTmmShYUwJF0SroWUAzSeB0hK47",
      "IndexName": "eds-pages",
      "Analyzer": "th.microsoft",
      "BatchSize": 50
    },
    "Dim": 2048,
    "Fetch": {
      "Concurrency": 4,
      "MinIntervalMs": 200,
      "MaxRetries": 6,
      "RetryBaseSeconds": 2,
      "MaxWaitSeconds": 120,
      "UserAgent": "EdsSearch-Indexer/1.0"
    },
    "Cleaning": {
      "ExtraDropClasses": [],
      "ExtraLinePatterns": [
        "^(?:\\s*(?:true|false|style|[a-z][a-z0-9]*(?:-[a-z0-9]+)+),?)+\\s*$"
      ],
      "ExtraRemovePatterns": [
        "\\b(?:bg-truthful-blue|full-bleed-bg|underline-title|center-title|center-content|central-align\\w*|pad-(?:top|bot|bottom|left|right)-\\d+)\\b,?"
      ]
    },
    "Weights": {
      "Title": 0.6,
      "Keywords": 1,
      "Description": 0.8,
      "Content": 0.5
    },
    "Embedding": {
      "Provider": "onnx",
      "ModelPath": "models/model.onnx",
      "TokenizerPath": "models/sentencepiece.bpe.model",
      "MaxTokens": 256,
      "MaxChunks": 3,
      "BatchSize": 16,
      "QueryPrefix": "query: ",
      "PassagePrefix": "passage: ",
      "Threads": 0
    },
    "Summary": {
      "TopDocs": 5,
      "PerDoc": 40,
      "MaxSentences": 4
    },
    "Llm": {
      "Enabled": false,
      "ModelPath": "models/phi35/cpu_and_mobile/cpu-int4-awq-block-128-acc-level-4",
      "Template": "phi3",
      "Evidence": 8,
      "MaxNewTokens": 300
    },
    "Ranking": {
      "Demote": [
        {
          "PathPattern": "/(news|newsroom|press|press-release|press-releases|hint)(/|$)",
          "Factor": 0.3
        }
      ]
    },
    "PublicBaseUrl": "https://main--site-prod--bangkok-bank.aem.live",
    "TimeZone": "Asia/Bangkok",
    "Jobs": [
      {
        "Name": "nightly-sync",
        "Enabled": true,
        "Cron": "0 2 * * *",
        "Action": "reindex"
      },
      {
        "Name": "hourly-update",
        "Enabled": true,
        "Cron": "0 * * * *",
        "Action": "update",
        "Deep": false
      },
      {
        "Name": "key-pages",
        "Enabled": false,
        "Cron": "*/10 * * * *",
        "Action": "update",
        "Urls": [
          "/en/",
          "/th/"
        ]
      }
    ]
  }
}