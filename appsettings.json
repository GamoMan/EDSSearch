{
  "Logging": {
    "LogLevel": {
      "Default": "Information"
    }
  },
  "Eds": {
    "BaseUrl": "https://main--site-prod--bangkok-bank.aem.live",
    "IndexPaths": [
      "/en/query-index.json",
      "/th/query-index.json"
    ],
    "Redis": "localhost:6379",
    "Dim": 2048,
    "Concurrency": 8,
    "Proxy": "",
    "ApiKey": "",
    "Weights": {
      "Title": 1,
      "Keywords": 0.6,
      "Description": 0.4,
      "Content": 0.2
    },
    "Embedding": {
      "Provider": "onnx",
      "ModelPath": "models/model.onnx",
      "TokenizerPath": "models/sentencepiece.bpe.model",
      "MaxTokens": 256,
      "MaxChunks": 3,
      "BatchSize": 16,
      "QueryPrefix": "query: ",
      "PassagePrefix": "passage: ",
      "Threads": 0
    }
  }
}